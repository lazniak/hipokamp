# Skopiuj jako /opt/hipokamp-sync/.env (chmod 600). Bez sekretów: tylko skrót sekretu bootstrapu.
#
# SHA-256 sekretu pierwszego urządzenia. Sekret wygeneruj losowo (np. openssl rand -base64 32), skrót daje
# `hipokamp sync bootstrap-hash` z sekretem w zmiennej HIPOKAMP_SYNC_BOOTSTRAP. Pusty = `sync init` wyłączony.
HIPOKAMP_SYNC_BOOTSTRAP_SHA256=

# Po przywróceniu data/hub.db z kopii: NOWA wartość (np. data przywrócenia) włącza przy starcie tryb odzyskiwania
# (zatwierdzanie urządzeń czeka na sync resync każdego admina i add-device --ack-lost-devices; docs/SYNC.md, sekcja 9).
#HIPOKAMP_SYNC_RESTORED=2026-10-05

# Limity (opcjonalnie): cały magazyn huba w MB i żądania na minutę na urządzenie.
#HIPOKAMP_SYNC_MAX_TOTAL_MB=4096
#HIPOKAMP_SYNC_RATE_PER_MIN=600
